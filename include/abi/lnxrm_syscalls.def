/* System call numbering (X-macro).
 *
 * Rules:
 *  - Numbers are compact and contiguous: entry i is exactly i, with no
 *    holes.  Anything the table does not name -- i.e. every number above
 *    LNXRM_SYSCALL_LAST -- falls into the dispatcher's `default` arm and
 *    answers LNXRM_ENOSYS (-38).
 *  - New calls take the next number: append at the end and bump
 *    LNXRM_SYSCALL_LAST in lnxrm_abi.h (the header rejects numbers past
 *    it at compile time).
 *  - Never renumber an existing entry from here on: user binaries are
 *    built from this table and must keep calling the same slot for the
 *    lifetime of the ABI.
 *
 * History: the table used to leave three holes for retired calls
 * (21 getcpu, 31 getkey, 33 move).  The 0..30 renumbering compacted them
 * away, so those old numbers now name the calls listed below -- only
 * pre-rebuild binaries from that era would notice.  setuid took 31 in the
 * T-031 round (the first number appended since the renumbering --
 * appended, never renumbered, exactly as the rule above says), fb_flip
 * took 32 for double buffering, sync took 33 (C27 persistence door),
 * kbd_get/inject/info took 34/35/36 for the keyboard I/O surface, and
 * mouse_get/info took 37/38 for the PS/2 aux pointer (2026-10-26).
 * input_pop/info took 39/40 for the unified input event queue over both
 * producers' decode paths (2026-10-30).
 * input_wait took 41 as the blocking variant: empty queue parks the caller on
 * an evq_lock-protected wait list, events wake one waiter, signals cut the
 * wait short (EINTR), ms deadline caps it (2026-10-31).
 * stat took 45 and gettimeofday 46 (2026-11-11): the first metadata door
 * that hands out no descriptor, and the first clock a program can read.
 * Both are two-argument calls -- stat(path, struct lnxrm_stat *) and
 * gettimeofday(struct lnxrm_timeval *, void *) -- so the entry plumbing
 * they use is the one every other call already had.
 * pipe took 47 (2026-11-15, PP3): a one-argument call whose single
 * argument is the USER address of an int[2] the kernel fills with the two
 * descriptors -- so the whole row is `h_pipe` reading rdi, and nothing
 * about the register contract changes.
 * reboot/chdir/getcwd took 48/49/50 (2026-11-15): three calls appended
 * together for /bin/reboot and the shell's cd/pwd builtins.  Arity is
 * zero (reboot), one (chdir(path)) and two (getcwd(buf, len)) -- reboot
 * carries no arguments at all, so its row is a wrapper that takes the
 * frame and answers nothing back: the CAP_SYS_ADMIN gate that may refuse
 * it runs from the table before the wrapper does, and the success path
 * resets the machine instead of returning.  A cwd lives in struct task
 * (sched.h); chdir is the only writer of it.
 * shm_open/shm_unlink took 51/52 (2026-11-16, S0): named shared-memory
 * objects.  Arity is three (shm_open(name, flags, size) -> fd) and one
 * (shm_unlink(name)); both take the USER address of the name, so the row
 * copies it with copy_user_str() exactly as open/unlink do, and neither
 * carries a gate -- any process may share memory with any other.  The
 * whole point of a SEPARATE number pair (rather than folding this into
 * open/unlink) is that these names live in their own table, not on the
 * volume: shm_open never touches the filesystem and shm_unlink never
 * takes a path, so neither can be spelled as an ordinary file by mistake.
 * dipc_open/dipc_recv/dipc_send took 53/54/55 (2026-11-17, S1a): driver
 * inter-process communication (kernel/ipc/dipc.c).  Arity is two
 * (dipc_open(name, flags) -> fd), four (dipc_recv(fd, buf, len, flags))
 * and four (dipc_send(fd, buf, len, flags)) -- the first three arguments
 * of a four-argument call land in rdi/rsi/r10 exactly as they do today,
 * and the FOURTH rides in rdx, the same register mmap's fourth argument
 * already reads out of the frame (h_mmap); nothing new is plumbed.  All
 * three rows carry GATE_ADMIN: a channel names a kernel object and its
 * byte stream, which is the same administrative surface as the raw key
 * bytes (kbd_get), the event queue (input_pop) and ps.  The names live in
 * a table of their own -- eight channels, created by the kernel, never by
 * a call -- so 53 can only ever OPEN one, never make one, and 55 exists
 * because the reverse path (a driver answering with decoded events) is
 * not a shared-memory write at all: it is a call into a sink the channel
 * was created with.
 *
 * Numbers are not the whole ABI: the ARITY of a call is too.  mmap (42)
 * grew from mmap(addr, len, prot) to the six-argument Linux shape
 * mmap(addr, len, prot, flags, fd, offset) when file mappings landed
 * (2026-11-09).  The number did not move -- nothing here is renumbered --
 * but a pre-rebuild binary calling the three-argument form reads whatever
 * rdx/rcx/r8 happened to hold, so userland and the kernel are rebuilt
 * together; that is what `make user` and the disk image rule already do.
 */
LNXRM_SYS(read, 0)
LNXRM_SYS(write, 1)
LNXRM_SYS(open, 2)
LNXRM_SYS(close, 3)
LNXRM_SYS(lseek, 4)
LNXRM_SYS(brk, 5)
LNXRM_SYS(getdent, 6)
LNXRM_SYS(dup2, 7)
LNXRM_SYS(nanosleep, 8)
LNXRM_SYS(getpid, 9)
LNXRM_SYS(fork, 10)
LNXRM_SYS(execve, 11)
LNXRM_SYS(exit, 12)
LNXRM_SYS(wait4, 13)
LNXRM_SYS(kill, 14)
LNXRM_SYS(uname, 15)
LNXRM_SYS(sigaction, 16)
LNXRM_SYS(sigprocmask, 17)
LNXRM_SYS(getppid, 18)
LNXRM_SYS(ps, 19)
LNXRM_SYS(sigreturn, 20)
LNXRM_SYS(diskinfo, 21)
LNXRM_SYS(mkdir, 22)
LNXRM_SYS(fb_info, 23)
LNXRM_SYS(fb_clear, 24)
LNXRM_SYS(fb_fill, 25)
LNXRM_SYS(fb_char, 26)
LNXRM_SYS(fb_puts, 27)
LNXRM_SYS(unlink, 28)
LNXRM_SYS(rmdir, 29)
LNXRM_SYS(rename, 30)
LNXRM_SYS(setuid, 31)
LNXRM_SYS(fb_flip, 32)
LNXRM_SYS(sync, 33)
LNXRM_SYS(kbd_get, 34)
LNXRM_SYS(kbd_inject, 35)
LNXRM_SYS(kbd_info, 36)
LNXRM_SYS(mouse_get, 37)
LNXRM_SYS(mouse_info, 38)
LNXRM_SYS(input_pop, 39)
LNXRM_SYS(input_info, 40)
LNXRM_SYS(input_wait, 41)
LNXRM_SYS(mmap, 42)
LNXRM_SYS(munmap, 43)
LNXRM_SYS(mprotect, 44)
LNXRM_SYS(stat, 45)
LNXRM_SYS(gettimeofday, 46)
LNXRM_SYS(pipe, 47)
LNXRM_SYS(reboot, 48)
LNXRM_SYS(chdir, 49)
LNXRM_SYS(getcwd, 50)
LNXRM_SYS(shm_open, 51)
LNXRM_SYS(shm_unlink, 52)
LNXRM_SYS(dipc_open, 53)
LNXRM_SYS(dipc_recv, 54)
LNXRM_SYS(dipc_send, 55)
